      {
        "name": "agyn-cli-init",
        "image": "agyn-cli-init:fixture",
        "resources": {},
        "volumeMounts": [
          {
            "name": "agyn-bin",
            "mountPath": "/agyn"
          }
        ],
        "securityContext": {
          "capabilities": {
            "drop": [
              "ALL"
