            "name": "ziti-identity",
            "mountPath": "/netfoundry"
          },
          {
            "name": "inline-files",
            "readOnly": true,
            "mountPath": "/etc/ssl/certs/ca-certificates.crt",
            "subPath": "inline-file-0"
          }
        ]
      },
      {
        "name": "ziti-sidecar",
        "image": "ziti-image",
